Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: TsenseI Hand
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
  Global Options:
    Fixed Frame: hand_base_link
    Background Color: 242; 245; 249
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.38
      Focal Point:
        X: 0.015
        Y: -0.015
        Z: 0.095
      Pitch: 0.15
      Yaw: 0.0
      Name: Current View
Window Geometry:
  Width: 1280
  Height: 900
